{
  "name": "blackjack3",
  "description": "Blackjack with Training and Standard modes, built with Phaser and Vite.",
  "version": "1.0.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruthlessfish/blackjack.git"
  },
  "author": "Shane Pearson <bubbafoley@gmail.com>",
  "bugs": {
    "url": "https://github.com/ruthlessfish/blackjack/issues"
  },
  "homepage": "https://github.com/ruthlessfish/blackjack#readme",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "vite build --config vite/config.prod.mjs",
    "clean": "rm -rf dist",
    "preview": "vite preview --config vite/config.prod.mjs",
    "test": "vitest run",
    "bump": "node scripts/bump-version.mjs",
    "simulate": "esbuild scripts/simulate.ts --bundle --platform=node --format=esm --log-level=warning | node --input-type=module -"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "~5.7.2",
    "vite": "^6.3.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "phaser": "4.0.0",
    "terser": "^5.39.0"
  }
}
